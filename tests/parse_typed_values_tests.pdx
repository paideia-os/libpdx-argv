  // ============================================================
  // case 18  parse_int_u64("18446744073709551615") → (1, u64::MAX)
  //   libpdx-argv.ENH-009: the boundary value itself must still
  //   succeed — the overflow gate must not be off-by-one.
  // ============================================================
  pub let run_case18 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 + ENH-009 case18 — parse_int_u64 at exactly u64::MAX must still succeed (the overflow gate's acc==Q/digit<=R boundary case). u64::MAX doesn't fit a cmp reg,imm (>0x7FFFFFFF), so it's staged via mov r15, imm64 and compared reg-reg, matching case9's precedent for the same reason.",
      block: {
        push rbx;
        push r15;
        sub rsp, 8;

