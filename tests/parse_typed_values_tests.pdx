  // ============================================================
  pub let run_case8 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_size('2m') → ok=1, bytes=2*1024*1024=2097152. Verifies shl 20 for MiB. Expected value 2097152 fits imm32.",
      block: {
        push rbx;
        lea rdi, [rip + f_size_2m];
        call parse_size;
        mov r14, rdx;
