  // ============================================================
  // case 22  parse_size("17179869183g") → (1, (2^34-1) << 30)
  //   libpdx-argv.ENH-009: one less than case21's mantissa (2^34-1)
  //   must still succeed — the shift-overflow gate's boundary must
  //   not be off-by-one either.
  // ============================================================
  pub let run_case22 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 + ENH-009 case22 — mantissa 2^34-1 with 'g' suffix: shr r9,34 yields 0 (all top-30 bits clear), so the shift proceeds and must return ok=1 with the exact product 18446744072635809792 (Python-verified). Staged via r15/mov imm64 + cmp reg,reg, same as case9/case18.",
      block: {
        push rbx;
        push r15;
        sub rsp, 8;

        lea rdi, [rip + f_size_g_boundary];
        call parse_size;
        mov r14, rdx;
        cmp rax, 1; jne case22_fail;
        mov r15, 18446744072635809792;
        cmp r14, r15; jne case22_fail;

        call record_pass;
