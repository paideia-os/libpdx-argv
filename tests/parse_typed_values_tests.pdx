// tests/parse_typed_values.pdx — libpdx-argv.M4-001
// Typed value parser matrix — Typed::parse_int_u64, parse_size,
// parse_timespan (leaf parsers from src/typed.pdx).
//
// Each case invokes one Typed::parse_* function on a NUL-terminated
// .rodata string and checks (ok, val) against expected. Every parser
// returns rax=ok (1/0), rdx=value; the test caller pulls rdx into r14
// (callee-preserved) so a comparison after the call still holds.
//
// Cases 18-24 (libpdx-argv.ENH-009): overflow detection. Each
// decoder's per-digit accumulation and (for parse_size/parse_timespan)
// its suffix multiply/shift is gated against a Python-verified
// threshold; cases pair an exact-boundary success with an
// one-past-boundary failure so the gate's own off-by-one risk is
// covered, not just "overflow is rejected somewhere".
//
// Module id in TestHarness::last_fail_tag: 2
//
// paideia-as compliance
// ---------------------
//   - Module ParseTypedValuesTests (PascalCase basename).
//   - run_* fns are non-leaf (call parse_* + record_*).
//   - 1-push (rbx) alignment; r14 spills the returned value across
//     record_pass (which clobbers rdx).
//   - No test mnemonic; every zero-check via cmp reg, 0.

module ParseTypedValuesTests = structure {

  // -- Fixture bytestrings (all NUL-terminated) --
  pub let f_int_zero    : [u8; 2]  = "0\0"
  pub let f_int_42      : [u8; 3]  = "42\0"
  pub let f_int_empty   : [u8; 1]  = "\0"
  pub let f_int_bad     : [u8; 3]  = "1a\0"

  pub let f_size_zero   : [u8; 2]  = "0\0"
  pub let f_size_1k     : [u8; 3]  = "1k\0"
  pub let f_size_1K     : [u8; 3]  = "1K\0"
  pub let f_size_2m     : [u8; 3]  = "2m\0"
  pub let f_size_3g     : [u8; 3]  = "3g\0"
  pub let f_size_kb_no  : [u8; 4]  = "1kb\0"    // "1kb" is NOT valid at M2
  pub let f_size_suffix_only : [u8; 2] = "k\0"  // suffix-only rejected

  pub let f_ts_60       : [u8; 3]  = "60\0"
  pub let f_ts_1s       : [u8; 3]  = "1s\0"
  pub let f_ts_2m       : [u8; 3]  = "2m\0"
  pub let f_ts_3h       : [u8; 3]  = "3h\0"
  pub let f_ts_7d       : [u8; 3]  = "7d\0"
  pub let f_ts_bad_w    : [u8; 3]  = "1w\0"    // 'w' unsupported at M2

  // -- libpdx-argv.ENH-009 overflow-detection fixtures --
  pub let f_int_u64_max      : [u8; 21] = "18446744073709551615\0" // u64::MAX exactly
  pub let f_int_u64_max_plus : [u8; 21] = "18446744073709551616\0" // u64::MAX + 1
  pub let f_size_mantissa_over : [u8; 21] = "18446744073709551616\0" // no suffix; mantissa itself > u64::MAX
  pub let f_size_g_over      : [u8; 13] = "17179869184g\0"  // 2^34; shl 30 overflows
  pub let f_size_g_boundary  : [u8; 13] = "17179869183g\0"  // 2^34 - 1; shl 30 fits exactly
  pub let f_ts_d_over        : [u8; 17] = "213503982334602d\0" // floor(u64::MAX/86400) + 1
  pub let f_ts_d_boundary    : [u8; 17] = "213503982334601d\0" // floor(u64::MAX/86400) exactly

  // -- libpdx-argv.ENH-018 INT range-validation fixtures --
  // The (min=1, max=64) range in the issue's fingerprint is exercised
  // by cases 25-28; f_int_32/f_int_65 pair boundary-in with
  // boundary-out (32 is inside; 65 is one past the upper cap).
  // f_int_zero/f_int_u64_max above are reused for the low-end and
  // upper-cap-not-wrap cases so no per-case duplication of the same
  // literal is introduced.
  pub let f_int_32 : [u8; 3] = "32\0"
  pub let f_int_65 : [u8; 3] = "65\0"

  // -- libpdx-argv.ENH-019 STRING-enum-validation fixtures (Closes #29) --
  // Fingerprint uses register_string_enum("--color", ID_COLOR,
  // &["auto\0","always\0","never\0"], 3) and exercises each half of
  // the {in-set, out-of-set, case-sensitive rejection, empty-set
  // sentinel} matrix. Argv is assembled inline in each run_caseN
  // via a 2-entry .bss argv scratch so the lookahead value form
  // (`--color auto`) — the shape the fingerprint literally uses —
  // is exercised end-to-end through parse_argv.
  pub let ecs_name_color   : [u8; 8]  = "--color\0"
  pub let ecs_bare_color   : [u8; 6]  = "color\0"       // FlagSpec key (no leading '--')
  pub let ecs_val_auto     : [u8; 5]  = "auto\0"
  pub let ecs_val_always   : [u8; 7]  = "always\0"
  pub let ecs_val_never    : [u8; 6]  = "never\0"
  pub let ecs_val_mauve    : [u8; 6]  = "mauve\0"       // not in the allowed set
  pub let ecs_val_AUTO_upper : [u8; 5] = "AUTO\0"       // case-sensitive miss
  // Allowed-values array-of-pointers. Registered as a [u64; 3] of
  // .rodata string pointers so register_string_enum sees a
  // pointer-scaled indexable base. The parser walks it via
  // `mov rdi, [r8 + r9*8]` which matches this layout exactly.
  pub let mut ecs_allowed : [u64; 3] = uninit @align(8)
  // Two-entry argv scratch reused across every ENH-019 case (each
  // case is full_reset-preceded so no cross-case state leaks).
  pub let mut ecs_argv : [u64; 2] = uninit @align(8)

  // ============================================================
  // case 1  parse_int_u64("0") → (1, 0)
  // ============================================================
  pub let run_case1 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_int_u64('0') → ok=1, val=0. Spill val to r14 across record_pass because rdx is caller-save. Simplest happy-path smoke — proves parse_int_u64 accepts a single '0' digit and returns 0.",
      block: {
        push rbx;
        lea rdi, [rip + f_int_zero];
        call parse_int_u64;
        mov r14, rdx;
        cmp rax, 1; jne case1_fail;
        cmp r14, 0; jne case1_fail;
        call record_pass;
        pop rbx; ret;
      case1_fail:
        mov rdi, 0x200000001;
        call record_fail;
        pop rbx; ret;
      }
    }

  // ============================================================
  // case 2  parse_int_u64("42") → (1, 42)
  // ============================================================
  pub let run_case2 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_int_u64('42') → ok=1, val=42. Two-digit accumulator: 4*10 + 2 = 42. Verifies the shl+add multiply-by-10 sequence produces the correct result.",
      block: {
        push rbx;
        lea rdi, [rip + f_int_42];
        call parse_int_u64;
        mov r14, rdx;
        cmp rax, 1; jne case2_fail;
        cmp r14, 42; jne case2_fail;
        call record_pass;
        pop rbx; ret;
      case2_fail:
        mov rdi, 0x200000002;
        call record_fail;
        pop rbx; ret;
      }
    }

