// tests/help_backend.pdx — libpdx-argv.M4-001
// HelpBackend::fill_doc_argv round-trip + DOC_TOOL_NAME identity.
//
// M3-002 wired --help back into `doc <tool>`. The library-side surface
// is minimal — a public [u8; 4] symbol and one argv-fill primitive.
// These tests verify:
//   1. DOC_TOOL_NAME byte-for-byte equals "doc\0".
//   2. After fill_doc_argv(argv, tool_name_ptr):
//        argv[0] == &DOC_TOOL_NAME
//        argv[1] == tool_name_ptr (byte-for-byte the caller-supplied ptr)
//   3. The synthesized argv[0] is stable across multiple calls (same
//      .rodata address every time, byte-for-byte).
//
// Module id in TestHarness::last_fail_tag: 7
//
// paideia-as compliance
// ---------------------
//   - Module HelpBackendTests (PascalCase basename).
//   - run_* fns non-leaf; 1-push (rbx) prologue.
//   - No test mnemonic; every zero-check via cmp reg, 0.

module HelpBackendTests = structure {

  // Caller-owned argv scratch for fill_doc_argv.
  pub let mut argv_scratch : [u64; 2] = uninit @align(8)

  // A representative tool name for the round-trip. (Consumers pass
  // their own tool_name literal — cat, pkg, ls, etc.)
  pub let sample_tool_name : [u8; 4] = "cat\0"

  // ============================================================
  // case1  DOC_TOOL_NAME byte identity.
  //   Verifies bytes 0..3 of DOC_TOOL_NAME are 'd','o','c','\0'.
  // ============================================================
  pub let run_case1 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 HelpBackend case1 — DOC_TOOL_NAME byte identity. Confirms the [u8; 4] literal is exactly {'d','o','c',0}. Any drift here would break consumer argv[0] stability (audit-record joins on shell-side rely on byte-for-byte match) and change the shared string's tool-recognition semantics.",
      block: {
        push rbx;

        lea rbx, [rip + DOC_TOOL_NAME];
        xor rax, rax; mov_b rax, [rbx + 0]; cmp rax, 0x64; jne hb1_fail;  // 'd'
        xor rax, rax; mov_b rax, [rbx + 1]; cmp rax, 0x6F; jne hb1_fail;  // 'o'
        xor rax, rax; mov_b rax, [rbx + 2]; cmp rax, 0x63; jne hb1_fail;  // 'c'
        xor rax, rax; mov_b rax, [rbx + 3]; cmp rax, 0;    jne hb1_fail;  // NUL

        call record_pass;
        pop rbx; ret;

      hb1_fail:
        mov rdi, 0x700000001;
        call record_fail;
        pop rbx; ret;
      }
    }

  // ============================================================
  // case2  fill_doc_argv round-trip.
  //   After fill_doc_argv(&argv_scratch, &sample_tool_name):
  //     argv_scratch[0] equals &DOC_TOOL_NAME
  //     argv_scratch[1] equals &sample_tool_name
  // ============================================================
  pub let run_case2 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 HelpBackend case2 — fill_doc_argv round-trip. Calls fill_doc_argv with argv_scratch + sample_tool_name; verifies both slots equal their expected pointer values byte-for-byte. Uses `lea r15, [rip + XXX]; cmp qword_slot, r15` because the tool_name_ptr may not fit imm32 (depends on layout). r15 spilled across the record_pass call via a 2-push prologue.",
      block: {
        push rbx;
        push r15;

        lea rdi, [rip + argv_scratch];
        lea rsi, [rip + sample_tool_name];
        call fill_doc_argv;

        // argv_scratch[0] must equal &DOC_TOOL_NAME
        lea r15, [rip + DOC_TOOL_NAME];
        lea rbx, [rip + argv_scratch];
        mov rax, [rbx + 0];
        cmp rax, r15; jne hb2_fail;

        // argv_scratch[1] must equal &sample_tool_name
        lea r15, [rip + sample_tool_name];
        mov rax, [rbx + 8];
        cmp rax, r15; jne hb2_fail;

        call record_pass;
        pop r15; pop rbx; ret;

      hb2_fail:
        mov rdi, 0x700000002;
        call record_fail;
        pop r15; pop rbx; ret;
      }
    }

  // ============================================================
  // case3  argv[0] stability across repeated calls.
  //   Two back-to-back fill_doc_argv calls must produce the identical
  //   argv[0] byte-for-byte. (Trivially true given fill_doc_argv is
  //   pure and reads DOC_TOOL_NAME by rip-relative lea; the test
  //   documents the contract for downstream shell audit-record joins.)
  // ============================================================
  pub let mut argv_scratch2 : [u64; 2] = uninit @align(8)

  pub let run_case3 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 HelpBackend case3 — argv[0] stability. Two independent fill_doc_argv calls write into two independent argv scratches. argv[0] slot must equal in both — the parameter that varies (rsi = tool_name_ptr) does not affect slot 0. Verifies the module doesn't accidentally use rsi for the argv[0] address.",
      block: {
        push rbx;
        push r15;

        lea rdi, [rip + argv_scratch];
        lea rsi, [rip + sample_tool_name];
        call fill_doc_argv;

        lea rdi, [rip + argv_scratch2];
        lea rsi, [rip + sample_tool_name];   // same tool_name
        call fill_doc_argv;

        // both argv[0]s must equal each other AND equal &DOC_TOOL_NAME.
        lea rbx, [rip + argv_scratch];
        mov rax, [rbx + 0];
        lea r15, [rip + argv_scratch2];
        mov rdx, [r15 + 0];
        cmp rax, rdx; jne hb3_fail;

        lea r15, [rip + DOC_TOOL_NAME];
        cmp rax, r15; jne hb3_fail;

        call record_pass;
        pop r15; pop rbx; ret;

      hb3_fail:
        mov rdi, 0x700000003;
        call record_fail;
        pop r15; pop rbx; ret;
      }
    }

  // ============================================================
  // case4  libpdx-argv.ENH-014 (Closes #24) — lazy --help auto-table
  //   Fingerprint: parse_argv on ["--help"] with 3 registered flags
  //   (each with help set) AND HelpBackend::set_doc_unavailable(1)
  //   in effect returns ERR_HELP_EMITTED (15) in rax AND writes the
  //   same code into ParsedArgs::error_code (the shared
  //   parse_argv_fail return path).
  //
  //   TestHarness::full_reset (ENH-014) zeros doc_backend_unavailable
  //   via pdxargv_help_reset before this case runs, so the opt-in
  //   here is scoped to this case only.
  //
  //   Byte-level fingerprint (three tab-separated lines to fd 1) is
  //   verified by a downstream paideia-os shell fixture; this case
  //   owns the RETURN-CODE assertion only, matching how the ENH-032
  //   --version auto-emit case owns its return-code assertion and
  //   leaves the byte-diff to a shell greps `VERSION OK` fixture.
  // ============================================================

  // Three tool-specific flag names + help strings for the fingerprint.
  // Ids 100..102 sit outside StdVocab's 1..9 reserved range per the
  // std_vocab.pdx convention.
  pub let hb4_name_input   : [u8; 6] = "input\0"
  pub let hb4_help_input   : [u8; 22] = "path to input file  \0"
  pub let hb4_name_output  : [u8; 7] = "output\0"
  pub let hb4_help_output  : [u8; 22] = "path to output file \0"
  pub let hb4_name_force   : [u8; 6] = "force\0"
  pub let hb4_help_force   : [u8; 21] = "overwrite if exists \0"

  // --help name pointer for the argv slot.
  pub let hb4_a_help : [u8; 7] = "--help\0"
  pub let mut hb4_argv : [u64; 1] = uninit @align(8)

  pub let run_case4 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-014 (Closes #24) case4 — lazy --help auto-table fingerprint. StdVocab::register_all registers --help with id=1; three tool-specific register_with_help calls populate the spec_help slots for ids 100..102. HelpBackend::set_doc_unavailable(1) trips the parser's --help auto-emit gate. parse_argv on ['--help'] must return ERR_HELP_EMITTED (15) in rax AND write the same code into ParsedArgs::error_code (both done by parse_argv_fail, the shared error-return path). The three sys_writes-per-row × three rows (five sys_writes per row: literal `--`, name, TAB, help, LF) land on fd 1 during the smoke run; verifying the byte sequence is the downstream shell fixture's job (parity with the ENH-032 --version auto-emit case, which owns the return-code assertion and leaves the byte-diff to a shell fixture greps `VERSION OK`). Case 4 in module id 7 → last_fail_tag = 0x700000004 on failure. 1-push (rbx) prologue → rsp%16: 8 → 0 for the nested call chain (full_reset, register_all, register_with_help, set_doc_unavailable, parse_argv, record_pass / record_fail — every non-leaf on that list self-aligns internally, so the 1-push here is both necessary and sufficient). rbx is used to hold the argv-scratch pointer across the parse_argv call (callee-save so it survives that non-leaf).",
      block: {
        push rbx;                            // align rsp (rsp%16: 8 → 0)

        call full_reset;
        call register_all;

        // Register three tool-specific flags WITH help text via the
        // new register_with_help path (ENH-014). Ids 100..102 are
        // outside StdVocab's reserved 1..9 range.
        lea rdi, [rip + hb4_name_input];  mov rsi, 1;  mov rdx, 100;
        lea rcx, [rip + hb4_help_input];
        call register_with_help;

        lea rdi, [rip + hb4_name_output]; mov rsi, 1;  mov rdx, 101;
        lea rcx, [rip + hb4_help_output];
        call register_with_help;

        lea rdi, [rip + hb4_name_force];  mov rsi, 0;  mov rdx, 102;
        lea rcx, [rip + hb4_help_force];
        call register_with_help;

        // Opt IN to the auto-emit fallback (default is opt-OUT so
        // existing consumers see zero behavior change on --help).
        mov rdi, 1;
        call set_doc_unavailable;

        // Prepare argv = ["--help"] (length 1). rbx holds the argv
        // base across the parse_argv call.
        lea rbx, [rip + hb4_argv];
        lea r11, [rip + hb4_a_help];
        mov [rbx + 0], r11;

        lea rdi, [rip + hb4_argv];
        mov rsi, 1;
        call parse_argv;

        // parse_argv must return ERR_HELP_EMITTED (15).
        cmp rax, 15; jne hb4_fail;

        // ParsedArgs::error_code must also record 15.
        lea r11, [rip + error_code];
        mov rax, [r11];
        cmp rax, 15; jne hb4_fail;

        call record_pass;
        pop rbx; ret;

      hb4_fail:
        mov rdi, 0x700000004;
        call record_fail;
        pop rbx; ret;
      }
    }
}
