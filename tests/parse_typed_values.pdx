  // ============================================================
  // case 17  parse_timespan("1w") → (0, 0)  — 'w' unsupported at M2
  // ============================================================
  pub let run_case17 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_timespan('1w') → ok=0. 'w' (weeks) is not part of the M2 suffix set {s,m,h,d}. After digit '1' the loop hits 'w' which is not a digit → pt_maybe_suffix; no arm matches → pt_fail. Verifies suffix-set completeness.",
      block: {
        push rbx;
        lea rdi, [rip + f_ts_bad_w];
        call parse_timespan;
        cmp rax, 0; jne case17_fail;
        call record_pass;
        pop rbx; ret;
      case17_fail:
