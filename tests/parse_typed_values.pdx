  // ============================================================
  // case 16  parse_timespan("7d") → (1, 604800)
  //   7*86400 = 604800 fits imm32 (0x93A80).
  // ============================================================
  pub let run_case16 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_timespan('7d') → ok=1, seconds=604800 (7*86400). Verifies pt_mul_86400 sequence. Expected fits imm32.",
      block: {
        push rbx;
        lea rdi, [rip + f_ts_7d];
