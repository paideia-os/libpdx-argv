      }
    }

  // ============================================================
  // case 15  parse_timespan("3h") → (1, 10800)
  // ============================================================
  pub let run_case15 : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M4-001 parse_timespan('3h') → ok=1, seconds=10800 (3*3600). Verifies pt_mul_3600 shl/add sequence.",
      block: {
