        mov rdi, 100;
        call count_flag_by_id;
        cmp rax, 2;
        jne case31_fail;

        // find_flag_by_id(100) must not be MAX_FLAGS.
        mov rdi, 100;
        call find_flag_by_id;
        cmp rax, 32;
