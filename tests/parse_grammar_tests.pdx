        call full_reset;

        // Register `v\0` as FKIND_BOOL id=100.
        lea rdi, [rip + case31_v_short];
        mov rsi, 0;                          // FKIND_BOOL
        mov rdx, 100;
        call flag_spec_register;

        lea r11, [rip + case31_arg];
        lea rbx, [rip + case31_argv];
        mov [rbx + 0], r11;

        lea rdi, [rip + case31_argv];
        mov rsi, 1;
