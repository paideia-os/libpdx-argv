# libpdx-argv v1.1.0 — dual-signed release manifest
#
# Format:  paideia-os pkg §6.3 (design/tooling/plan.md).
# Signer:  paideia-as v0.33-crypto-kdf `release --sign` (ML-DSA-65).
# Verify:  pkg install / pkg verify (design/user/model.md §11.2).
#
# This file is the load-bearing artifact of the 1.1 release. Its two
# signature blocks bind the payload above to (a) the author key and
# (b) the paideia_root_pk countersignature applied at admission time
# by the pkgs.paideia-os mirror. `pkg install --strict` refuses this
# package while either block carries a PENDING sentinel.
#
# libpdx-argv.ENH-030 (2026-09-02): every 1.0 source file changed
# under the cross-module symbol rename (parsed_args_reset,
# flag_spec_reset, flag_spec_register, schema_emit_reset,
# schema_emit_register), so the per-source sha256 lines below are
# marked DEFERRED-COMPUTED-AT-RELEASE-RUNNER; the release runner
# recomputes them and re-signs at admission time. Downstream
# consumers pinning 1.0.0 keep working; anyone bumping to 1.1.0
# updates their bare-name call sites to the new mangled names.

# ---- payload (signed region, everything between "PAYLOAD BEGIN"
# ---- and "PAYLOAD END" is fed into ml_dsa_65_sign as a single
# ---- newline-preserved byte stream).

PAYLOAD BEGIN
manifest_version:  1
name:              libpdx-argv
version:           1.1.0
wave:              R49
kind:              library
license:           MIT
license_sha256:    5d10906e3e9407412fd51592e3dd968251a4797b8ffdcc9e862d8fb1f3925e2b
repo:              github.com/paideia-os/libpdx-argv
released:          2026-09-02
released_by:       paideia-os-team
source_tree_root:  DEFERRED-COMPUTED-AT-RELEASE-RUNNER
source_tree_algo:  sha256-of-concat-sorted-source-files
declared_output_schemas:
  - PdxArgvParsed@0.1
  - PdxArgvRecord@0.1
requires_caps:     (none)
deps:              (none — pure userspace; see deps.list)
toolchain_floor:   paideia-as >= 0.33-crypto-kdf
sources:
  src/flag_spec.pdx      sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/help_backend.pdx   sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/parsed_args.pdx    sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/parser.pdx         sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/schema_emit.pdx    sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/schema_invoke.pdx  sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/std_vocab.pdx      sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  src/typed.pdx          sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
sidecar_files:
  caps.decl              sha256=be4cfa8ad2d04d44778c71595566d74b8a92b3218566f7d18a61f7b20f8f0058
  deps.list              sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
  doc/libpdx-argv.pdxdoc sha256=DEFERRED-COMPUTED-AT-RELEASE-RUNNER
milestones_landed:
  M1-001 #1  scaffold + ParsedArgs struct + long-flag grammar
  M1-002 #2  short-flag grammar one-per-hyphen (clustered reject)
  M2-001 #3  typed flag arguments (--older-than 7d, --size > 1MB)
  M2-002 #4  9-flag standard vocabulary from I3
  M2-003 #5  positional-argument list handling
  M3-001 #6  alternate invocation: typed schema record -> ParsedArgs
  M3-002 #7  --help back-end integration with doc <tool>
  M3-003 #8  --schema prints tool's declared output schemas
  M4-001 #9  parse-correctness matrix + clustered-short reject + typed diagnostics + --help RT
  M5-001 #10 dual-signed release + .pdxdoc + mirror push
post_1_0_landed:
  ENH-022 #32 rename test modules to *Tests
  ENH-023 #33 qualify smoke-driver cross-module call sites
  ENH-029 #39 scaffold pkgs/consumers.list
  ENH-030 #40 rename module-scope colliding exports (reset, register)
PAYLOAD END

# ---- signatures (each block is <= 4KiB; two blocks always present;
# ---- pkg install requires BOTH signature slots to verify against
# ---- the payload byte-stream above under the referenced key.)

SIGNATURE author BEGIN
key_id:    paideia-os-team@v0.33
algorithm: ML-DSA-65
signature: PENDING:paideia-os-team-key@v0.33
# Populated by `paideia-as release --sign libpdx-argv-1.0.0` on the
# release-runner host once the paideia-as v0.33-crypto-kdf toolchain
# and the release-key HSM slot are reachable. The signature bytes
# replace the PENDING sentinel in place; nothing else in this file
# changes at signing time.
SIGNATURE author END

SIGNATURE paideia_root BEGIN
key_id:    paideia_root_pk@R32-mint
algorithm: ML-DSA-65
signature: PENDING:paideia_root_pk@R32-mint
# Applied at admission time by the pkgs.paideia-os mirror runner
# (paideia-os meta issue T-INFRA-001). The runner verifies the
# author signature above and, on success, adds this counter-
# signature over the same payload byte stream before writing the
# package into the mirror tree at
# `pkgs.paideia-os/main/libpdx-argv/1.0.0/manifest.pdxsig`.
SIGNATURE paideia_root END
