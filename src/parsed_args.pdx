// src/parsed_args.pdx — libpdx-argv.M1-001 + M2-001 + M2-002 + M2-003 + M3-001
// ParsedArgs record: singleton .bss storage for one parse_argv() call.
// See design/architecture.md §2–§3 (M1 record shape) and §9 (M2
// additions: typed flags, standard vocabulary, positional-list) and
// §10 (M3 additions: schema-record invocation, doc back-end, --schema
// emission). Upstream: design/tooling/r49-r50-plan.md §3.3 + §5.12
// (paideia-os).

module ParsedArgs = structure {
  // --- Error codes (0 = OK). Consumers pattern-match on these. ---------
  // Existing (M1):
  pub let ERR_OK                : u64 = 0
  pub let ERR_FLAG_OVERFLOW     : u64 = 1
  pub let ERR_POS_OVERFLOW      : u64 = 2
  // ENH-026 (libpdx-argv.ENH-026, wired 2026-09-02): argv slot is
  // neither flag-shaped (starts with '-' AND has at least one byte
  // after) NOR a valid positional (does NOT start with '-' AND is
  // non-empty). Concrete triggers today:
  //   - empty argv slot (""), and
  //   - bare "-" (starts with '-', nothing after — not a flag; also
  //     not treated as a positional under ENH-026 semantics).
  // Bare "--" is out of scope: it is the M2-003 positional-sentinel
  // and continues to set ddash_seen (see Parser::parse_argv). Slots
  // that appear after the sentinel are always positional and never
  // reach the malformed classifier.
  pub let ERR_UNKNOWN_ARG_FORM  : u64 = 3   // malformed argv slot (ENH-026)
  pub let ERR_CLUSTERED_SHORT   : u64 = 4   // M1-002 clustered-short reject;
                                            // UNREACHABLE from Parser::parse_argv
                                            // after libpdx-argv.ENH-013 (#23)
                                            // relaxed the grammar. Constant
                                            // retained for wire-form back-compat
                                            // (a consumer's dispatch table may
                                            // still switch on the number).
                                            // See ERR_CLUSTER_WITH_ARITY (16)
                                            // for the ENH-013 replacement code.
  pub let ERR_LONG_MISSING_NAME : u64 = 5   // "--" or "--=foo"
  // Added by M2-001 (typed flags):
  pub let ERR_MISSING_VALUE     : u64 = 6   // typed flag reached EOL without a value
  // Added by M3-001 (schema-record invocation path). All three surface via
  // SchemaInvoke::parse_from_schema_record. The alt path shares the same
  // ERR_* space as parse_argv so a consumer's error-dispatch table can
  // treat both invocation paths uniformly.
  pub let ERR_SCHEMA_BAD_MAGIC          : u64 = 7  // wire-form magic mismatch
  pub let ERR_SCHEMA_UNSUPPORTED_VERSION: u64 = 8  // version != 1
  pub let ERR_SCHEMA_BAD_LAYOUT         : u64 = 9  // record too short or count > MAX
  // Added by libpdx-argv.ENH-001 (offset + terminator validation on the
  // schema-record path). Distinguished from ERR_SCHEMA_BAD_LAYOUT (a
  // malformed header) because these two fire on a per-flag/per-pos
  // basis and set error_arg_index to the offending loop index — a
  // consumer's audit record can tell "sender built the header wrong"
  // apart from "sender pointed us at attacker-chosen bytes".
  pub let ERR_SCHEMA_BAD_OFFSET         : u64 = 10 // name/value/pos offset out of range
  pub let ERR_SCHEMA_UNTERMINATED       : u64 = 11 // string ran to record end with no NUL
  // Added by libpdx-argv.ENH-004 (opt-in strict mode). Fires on both
  // invocation paths when FlagSpec::set_strict(1) is in effect and a
  // flag name is not registered with FlagSpec (FKIND_UNKNOWN). Default
  // (FlagSpec::strict_mode == 0) is unchanged permissive behaviour —
  // an unregistered flag stores as boolean, same as before ENH-004.
  pub let ERR_UNKNOWN_FLAG              : u64 = 12 // strict mode: unregistered flag name
  // Added by libpdx-argv.ENH-032 (Closes #25): library-owned `--version`
  // auto-emitter. `Parser::parse_argv` sets this code, writes the
  // fingerprint to fd 1 via `VersionBackend::emit_default`, and
  // returns immediately when it observes an argv slot equal to
  // `--version` (dispatched by id == StdVocab::STD_ID_VERSION, not by
  // name compare) AND the tool has not opted out via
  // `VersionBackend::set_override(1)`. A tool that intends to render
  // its own `--version` text calls `set_override(1)` at bootstrap;
  // parse_argv then stores `--version` as an ordinary flag and returns
  // ERR_OK, and the tool dispatches on
  // `find_flag_by_id(STD_ID_VERSION)` as before.
  //
  // Return-code semantics for a consumer: `ERR_VERSION_EMITTED` is a
  // success signal, not an error — the tool exits 0 in response. It
  // occupies the ERR_* space (rather than a separate return-code
  // family) so a consumer's existing "if err != ERR_OK { … }" branch
  // still fires, keeping the dispatch shape uniform. Callers that need
  // to distinguish it from a real parse error compare `err ==
  // ERR_VERSION_EMITTED` against the others.
  pub let ERR_VERSION_EMITTED           : u64 = 13
  // Added by libpdx-argv.ENH-018 (Closes #28): INT flag range violation.
  // Set by Typed::parse_int_u64_ranged when the caller passes a
  // (min, max) pair with at least one nonzero side (the (0, 0) pair
  // is the "range OFF" sentinel and never trips this code) and the
  // decoded value falls outside the closed unsigned interval
  // [min, max]. On the trip, parse_int_u64_ranged writes this code to
  // ParsedArgs::error_code and returns (ok = 0, val = 0) so a
  // consumer's existing `if (ok == 0)` branch fires; the error_code
  // slot then distinguishes an out-of-range value from a decode
  // failure (which does not touch error_code, matching Typed's
  // pre-ENH-018 contract).
  //
  // The gate uses unsigned compares end-to-end (JB / JA), so the full
  // u64 range works — including `--jobs 18446744073709551615` against
  // (min = 1, max = 64), which is rejected here (upper cap) rather
  // than by the decoder's own overflow gate. New klog tag:
  // `pdxargv.int-range`.
  pub let ERR_INT_RANGE                 : u64 = 14
  // Added by libpdx-argv.ENH-014 (Closes #24): library-owned `--help`
  // auto-table fallback. Set by `Parser::parse_argv` when it observes
  // an argv slot equal to `--help` (or a single-letter short flag with
  // id == StdVocab::STD_ID_HELP) AND the tool has opted into the
  // fallback via `HelpBackend::set_doc_unavailable(1)`. Before
  // returning this code the parser calls `HelpBackend::emit_from_argspec`
  // which walks the `FlagSpec` table and prints a two-column
  // `flag<TAB>help-text` line to fd 1 per registered flag whose
  // `spec_help[i]` slot was populated (via `register_with_help`); a
  // registration whose help slot is null (every plain `flag_spec_register`
  // call sets it null) is silently suppressed from the emit — a tool
  // that populates ONLY some help slots gets ONLY those lines.
  //
  // Like `ERR_VERSION_EMITTED` this is a success signal, not an error
  // — the tool exits 0 in response. It occupies the ERR_* space
  // (rather than a separate return-code family) so a consumer's
  // existing `if err != ERR_OK { … }` branch still fires, keeping the
  // dispatch shape uniform. Callers that need to distinguish it from
  // a real parse error compare `err == ERR_HELP_EMITTED` against the
  // others. Existing consumers that call the plain `flag_spec_register`
  // (with no help text) AND do not call `set_doc_unavailable(1)` see
  // zero behavior change: `--help` is stored as an ordinary flag and
  // the tool dispatches to its own `doc <tool>` renderer as before.
  //
  // The auto-table only fires when the tool has explicitly signalled
  // that the `doc` back-end is unavailable in its address space (a
  // static link of `doc` is the P0 pattern; a tool built without that
  // link calls `set_doc_unavailable(1)` at bootstrap and gets the
  // in-process fallback instead). New klog tag: `pdxargv.help-auto`.
  pub let ERR_HELP_EMITTED              : u64 = 15
  // Added by libpdx-argv.ENH-013 (Closes #23): clustered short flag
  // whose spelling contains at least one value-consuming registration.
  // Set by `Parser::parse_argv` when a short-flag cluster `-abc` is
  // observed AND FlagSpec::lookup on any letter returns a kind that
  // consumes a value (FKIND_STR / FKIND_INT / FKIND_TIMESPAN /
  // FKIND_SIZE / FKIND_ENUM). Every letter in an accepted cluster must
  // be either FKIND_BOOL (0) or, under permissive mode, FKIND_UNKNOWN
  // (0xFF; treated as boolean per M2-001). A single value-consuming
  // kind in the cluster fails the whole cluster with this code before
  // any letter is dispatched — no partial storage — so the caller sees
  // flag_count unchanged from what it was at cluster entry. Strict
  // mode's ENH-004 rule takes precedence: an unregistered letter under
  // FlagSpec::set_strict(1) still fails with ERR_UNKNOWN_FLAG (12)
  // rather than being coerced to BOOL, exactly as the single-letter
  // short-flag path already does.
  //
  // Rationale for a distinct code (vs collapsing into
  // ERR_CLUSTERED_SHORT=4): pre-ENH-013 every cluster was rejected as
  // a category error (D3 one-per-hyphen contract). ENH-013 narrows
  // that policy to the case that would silently swallow a value
  // (`-nX` where `-n` is INT would bind 'X' as the value in GNU getopt
  // and would need a value in libpdx-argv, both of which contradict
  // the cluster expansion `-n -X`), preserving BOOL/COUNTED cluster
  // acceptance as the mainstream idiom (`-vv` for verbosity,
  // `-abc` for three switches). Consumers that want to distinguish
  // "clustering rejected because of arity" from any surviving
  // ERR_CLUSTERED_SHORT (currently unreachable — the classifier no
  // longer emits it) get the split cleanly at the ERR_* level.
  //
  // New klog tag: `pdxargv.short-cluster`.
  pub let ERR_CLUSTER_WITH_ARITY        : u64 = 16
  // Added by libpdx-argv.ENH-017 (Closes #27): INT-flag value that
  // failed decimal decoding. Set by `Parser::parse_argv_ex` when the
  // caller passes `ARGV_COLLECT_ALL_ERRORS` in `parse_flags` AND the
  // parser just consumed argv[i+1] as the value of an FKIND_INT flag
  // AND `Typed::parse_int_u64(value)` returned `ok == 0`. The inline
  // validation only fires under collect-all mode — a plain
  // `parse_argv(argv, argc)` (i.e. `parse_argv_ex(argv, argc, 0)`)
  // continues to store the flag with its raw string value and lets
  // the consumer's own dispatch-site decoder catch the bad value
  // (pre-ENH-017 contract preserved).
  //
  // The record is appended to `error_ring_codes[error_ring_count]`
  // with `argv_index = r13` (the argv slot the failing value sits at,
  // i.e. the last consumed slot after the parser advanced past the
  // flag), and — if this is the FIRST error observed by the parse —
  // ALSO written to `ParsedArgs::error_code` and `error_arg_index` so
  // a consumer that never opts into the ring API still sees the first
  // failure via the pre-existing slots. The stored flag itself is
  // NOT rolled back — `flag_names[k] / flag_values[k] / flag_ids[k] /
  // flag_kinds[k]` all reflect the (name, raw-string-value, id, INT)
  // triple the parser observed. Consumers that walk ParsedArgs post-
  // parse in collect-all mode should treat any FKIND_INT slot whose
  // value fails `parse_int_u64` as a diagnostic-only entry.
  //
  // Not emitted on the schema-record invocation path (SchemaInvoke
  // has no `argv_index` to attach and the record's typed values are
  // already decoded upstream).
  //
  // New klog tag: `pdxargv.collect-errors`.
  pub let ERR_BAD_INT                   : u64 = 17

  // --- ENH-017 collect-all-errors mode (Closes #27) -------------------
  // `Parser::parse_argv_ex(argv, argc, parse_flags)` opts into
  // multi-error accumulation via bit 0 of `parse_flags`. When the bit
  // is set, every recoverable parse failure (ERR_UNKNOWN_FLAG /
  // ERR_MISSING_VALUE / ERR_UNKNOWN_ARG_FORM / ERR_LONG_MISSING_NAME /
  // ERR_CLUSTER_WITH_ARITY / ERR_BAD_INT) is recorded into
  // `error_ring_codes` + `error_ring_indices` and the parser advances
  // past the offending argv slot instead of returning. Storage-
  // exhaustion errors (ERR_FLAG_OVERFLOW / ERR_POS_OVERFLOW) still
  // stop the parse — the storage arrays are full and continuing would
  // hit the same overflow gate on every subsequent slot — but the
  // ring itself is populated with the hard-fail code before the parser
  // returns, so a consumer's post-parse ring walk sees the terminal
  // reason alongside every prior recoverable error.
  //
  // The bit is inert when unset: `parse_argv(argv, argc)` (the pre-
  // ENH-017 entry point) is a thin wrapper that calls
  // `parse_argv_ex(argv, argc, 0)`, and the parser's flow through
  // every ERR_* path is byte-identical to today's behavior — the
  // ring still records the first error but the parser returns
  // immediately after that record, so `error_count() == 1` and the
  // return value matches the pre-ENH-017 fail contract.
  //
  // Bit assignments (bit N clear = pre-ENH-017 default):
  //   bit 0 : ARGV_COLLECT_ALL_ERRORS — keep parsing after recoverable
  //           errors; accumulate up to MAX_COLLECTED_ERRORS records.
  //   bits 1..63 : reserved, must be zero (currently ignored; a
  //                future ENH may repurpose them).
  pub let ARGV_COLLECT_ALL_ERRORS       : u64 = 1

  // Ring capacity — the number of error records a single parse may
  // accumulate before subsequent errors are silently dropped from
  // the ring. Overflow behaviour is intentional and quiet: the
  // dropped errors still fire their normal advance-past-argv-slot
  // recovery (so parse-side state stays coherent), but the ring
  // itself never grows past this bound. A consumer that suspects it
  // is dropping errors sizes its argv defensively or opts out of
  // collect-all mode.
  //
  // 16 is the smallest cap that covers every I3 tool's worst-case
  // argv (12 flags + 4 positionals for `pkg install --dry-run
  // --json ...`) while staying inside 256B of .bss (16 slots × 16B
  // per record). Larger caps trade .bss for the rare case of a
  // very long fuzz-test argv where every slot is malformed.
  pub let MAX_COLLECTED_ERRORS          : u64 = 16

  // --- Slot counts. Both fit inside cmp reg, imm ≤ 0x7FFFFFFF. --------
  pub let MAX_FLAGS : u64 = 32
  pub let MAX_POS   : u64 = 32

  // --- Singleton storage (bootstrap-scope; M4 migrates to caller-owned). -
  // Existing (M1) slots:
  pub let mut flag_names        : [u64; 32] = uninit @align(8)
  pub let mut flag_values       : [u64; 32] = uninit @align(8)
  pub let mut flag_count        : u64       = uninit @align(8)
  pub let mut pos_ptrs          : [u64; 32] = uninit @align(8)
  pub let mut pos_count         : u64       = uninit @align(8)
  pub let mut error_code        : u64       = uninit @align(8)
  pub let mut error_arg_index   : u64       = uninit @align(8)  // set by parser on error
  pub let mut emit_schema       : u64       = uninit @align(8)  // 1 iff --pdx-schema seen

  // Added by M2-001 / M2-002: per-flag kind + id populated from
  // FlagSpec::lookup during parse. Unregistered flags land as
  // flag_kinds[k] = FKIND_UNKNOWN (0xFF) and flag_ids[k] = 0.
  pub let mut flag_ids          : [u64; 32] = uninit @align(8)
  pub let mut flag_kinds        : [u64; 32] = uninit @align(8)

  // Added by M2-003: `--` sentinel discipline.
  //   ddash_seen == 0  → no `--` in argv; ddash_arg_index is undefined.
  //   ddash_seen == 1  → `--` was seen at argv[ddash_arg_index]; every
  //                      argv[i] with i > ddash_arg_index went into
  //                      pos_ptrs regardless of its first byte.
  pub let mut ddash_seen        : u64       = uninit @align(8)
  pub let mut ddash_arg_index   : u64       = uninit @align(8)

  // Added by libpdx-argv.ENH-017 (Closes #27): parallel arrays that
  // together hold the accumulated (err_code, argv_index) pairs from
  // the current parse. `error_ring_count` is the live entry count
  // (0..MAX_COLLECTED_ERRORS); entries at indices ≥ error_ring_count
  // are dead and must not be read via error_at(). Populated by
  // Parser::parse_argv_ex on every recoverable ERR_* fail (see
  // ARGV_COLLECT_ALL_ERRORS above); the pre-existing scalar
  // error_code / error_arg_index slots hold the FIRST error observed
  // (position 0 in the ring). Both arrays are consumed by index up
  // to error_ring_count, so parsed_args_reset zeroes only the
  // counter — stale trailing entries are unreachable.
  //
  // Storage cost: 16 slots × 8 bytes × 2 arrays = 256 bytes .bss.
  // The parallel-array shape (versus a struct-of-16-byte-slots
  // packing) is deliberate: it keeps every write inside the paideia-
  // as `mov [reg + rcx*8], reg` addressing mode without any scaled
  // (rcx*16) or two-store sequences.
  pub let mut error_ring_codes    : [u64; 16] = uninit @align(8)
  pub let mut error_ring_indices  : [u64; 16] = uninit @align(8)
  pub let mut error_ring_count    : u64       = uninit @align(8)

  // parsed_args_reset() — clear the M1 + M2 bookkeeping slots.
  // The flag_names / flag_values / flag_ids / flag_kinds / pos_ptrs
  // arrays are consumed by index up to flag_count / pos_count, so
  // stale trailing entries are unreachable and do not need zeroing.
  //
  // libpdx-argv.ENH-030 (Wave 2 rename): this used to be `reset`;
  // renamed to `parsed_args_reset` because three sibling modules
  // (FlagSpec, SchemaEmit) each shipped their own `reset` and every
  // real consumer links at least two of them together, producing a
  // fatal `multiple definition of 'reset'` at link time. Per-module
  // prefix ends the collision at the source level.
  pub let parsed_args_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M1-001 + M2 additions + ENH-017 + ENH-030 rename: zero the ParsedArgs bookkeeping slots so parse_argv starts from a known-empty state. Only counter/flag slots need explicit zero; the fixed-size arrays are consumed by index. r11 is scratch (paideia-as conformance). xor rax,rax produces the zero value written into each slot; it is one byte cheaper than mov rax,0 and produces the same result. M2 adds ddash_seen + ddash_arg_index; flag_ids/flag_kinds do NOT need zeroing here because they are consumed by index up to flag_count. ENH-017 adds error_ring_count — the error_ring_codes / error_ring_indices arrays are consumed by index up to error_ring_count, so trailing entries stay stale and error_at() gates reads on the count. ENH-030 renames the exported symbol from `reset` to `parsed_args_reset` to end the multi-module link collision — body otherwise byte-identical to the M1 shape.",
      block: {
        xor rax, rax;                            // rax = 0
        lea r11, [rip + flag_count];        mov [r11], rax;
        lea r11, [rip + pos_count];         mov [r11], rax;
        lea r11, [rip + error_code];        mov [r11], rax;
        lea r11, [rip + error_arg_index];   mov [r11], rax;
        lea r11, [rip + emit_schema];       mov [r11], rax;
        lea r11, [rip + ddash_seen];        mov [r11], rax;
        lea r11, [rip + ddash_arg_index];   mov [r11], rax;
        lea r11, [rip + error_ring_count];  mov [r11], rax;
        ret;
      }
    }

  // find_flag_by_id(id) -> k   [where k = flag index, or MAX_FLAGS = 32
  //                             if not seen]
  //
  // Consumer usage:
  //   let k = ParsedArgs::find_flag_by_id(StdVocab::STD_ID_HELP)
  //   if k != 32 { ... --help was seen ... }
  //
  // Signature: (u64) -> u64 !{mem} @{}
  // rdi (in)  = target id (0 = "no id / unregistered" — this scan
  //             SKIPS any slot whose flag_ids[k] is 0, so passing 0
  //             ALWAYS returns 32 regardless of how many unregistered
  //             flags are in the record; see ENH-024)
  // rax (out) = k (0..flag_count-1) if a flag with a NONZERO id
  //             matching rdi was stored; else 32 (== MAX_FLAGS).
  //
  // ENH-024 rationale (libpdx-argv.ENH-024): permissive mode stores
  // an unregistered flag with flag_ids[k] = 0 (parser.pdx sets
  // r15 = rdx from FlagSpec::lookup, and lookup returns id=0 for
  // FKIND_UNKNOWN). Before ENH-024 the scan below matched any slot
  // whose id equalled the caller-supplied rdi, INCLUDING id==0 slots
  // when the caller passed 0 — which contradicted the "passing 0
  // always returns 32" contract in the docstring. Skipping id==0
  // slots restores the contract without changing behaviour for any
  // caller passing a legitimate (nonzero) id: id 0 is reserved for
  // "unregistered" in the FlagSpec id-space (per StdVocab: standard
  // vocabulary is 1..9, tool-specific ids start at 100), so no
  // registered flag can have id==0 to be legitimately looked up.
  //
  // Duplicate-flag policy (libpdx-argv.ENH-008): every occurrence of a
  // repeated flag gets its own slot (Parser::parse_argv never
  // de-duplicates), and this function is FIRST-WINS — it returns the
  // lowest-indexed match. A consumer that wants mainstream CLI /
  // shell-alias-composability semantics (a later `--color=never`
  // overriding an earlier `--color=auto`) wants
  // `find_last_flag_by_id` instead. `count_flag_by_id` is for the
  // repeat-count idiom (`-v -v -v` for a verbosity level). This
  // function's own behaviour is unchanged by ENH-008 — existing
  // consumers that already call `find_flag_by_id` see no difference.
  //
  // Leaf. Iterates flag_count entries once. O(MAX_FLAGS) worst case.
  //
  // Register plan (all caller-save; leaf):
  //   rcx = loop index i
  //   rax = flag_count upper bound / return value
  //   r8  = flag_ids table base (hoisted once — never touched across
  //         iterations)
  //   r11 = scratch (only used briefly to load flag_count)
  //   rdx = per-iteration flag_ids[i]
  pub let find_flag_by_id : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M2-002 + ENH-024 find_flag_by_id — linear scan over the flag_ids table returning the storage index k, or MAX_FLAGS (=32) if the id was never registered against a seen flag. ENH-024 adds an id==0 skip inside the loop body: permissive-mode unregistered flags land in flag_ids[k] with id==0 (parser.pdx line ~196 stores r15=rdx from FlagSpec::lookup, and lookup returns id=0 for FKIND_UNKNOWN), and the pre-ENH-024 scan would erroneously match such a slot if the caller passed 0 as the target id — contradicting the 'passing 0 returns MAX_FLAGS' docstring contract. Behaviour for any legitimate (nonzero) target is unchanged: registered ids are ≥ 1 (StdVocab 1..9; tool-specific ≥ 100), so a nonzero rdi never compares equal to an id==0 slot anyway; the skip is defensively correct. Leaf; only caller-save regs used. r8 hoists the flag_ids base so the loop body issues one indexed load per probe. Return uses `mov rax, 32` which fits ≤ 0x7FFFFFFF trivially. Never faults: the loop bound (flag_count, read once at head) is ≤ MAX_FLAGS by construction (Parser enforces the cap before every write into flag_ids).",
      block: {
        xor rcx, rcx;                            // rcx = i = 0
        lea r11, [rip + flag_count];
        mov rax, [r11];                          // rax = flag_count
        lea r8, [rip + flag_ids];                // r8  = &flag_ids[0]

      ffbi_loop:
        cmp rcx, rax;
        jge ffbi_not_found;

        mov rdx, [r8 + rcx*8];                   // rdx = flag_ids[i]
        cmp rdx, 0;                              // ENH-024: skip unregistered
        je ffbi_skip;
        cmp rdx, rdi;
        je ffbi_found;

      ffbi_skip:
        add rcx, 1;
        jmp ffbi_loop;

      ffbi_found:
        mov rax, rcx;
        ret;

      ffbi_not_found:
        mov rax, 32;                             // MAX_FLAGS
        ret;
      }
    }

  // find_last_flag_by_id(id) -> k   [libpdx-argv.ENH-008 + ENH-024]
  //   rdi (in)  = target id (0 = "no id / unregistered" — this scan
  //               SKIPS id==0 slots, so passing 0 ALWAYS returns 32
  //               regardless of how many unregistered flags are
  //               stored; see ENH-024 on find_flag_by_id above for
  //               the full rationale)
  //   rax (out) = k of the HIGHEST-indexed (last-parsed) flag with
  //               a NONZERO id matching rdi, or MAX_FLAGS (=32) if
  //               none.
  //
  // Last-wins companion to find_flag_by_id: scans downward from
  // flag_count-1 so a later occurrence of a repeated flag always
  // shadows an earlier one — e.g. after `--color=auto --color=never`,
  // this returns the slot whose flag_values[k] is "never".
  //
  // Leaf. Register plan (all caller-save):
  //   rcx = loop cursor, counts down from flag_count to 0 (also the
  //         return value on a match)
  //   r8  = flag_ids table base (hoisted once)
  //   rdx = per-iteration flag_ids[k]
  //   r11 = scratch (only used briefly to load flag_count)
  pub let find_last_flag_by_id : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-008 + ENH-024 find_last_flag_by_id — downward linear scan over flag_ids returning the highest-indexed match (last-wins), or MAX_FLAGS (=32) if the id was never stored. ENH-024 skips id==0 slots (permissive-mode unregistered flags) inside the loop for the same reason as find_flag_by_id: id 0 is reserved as the 'unregistered' sentinel in the FlagSpec id-space, so the skip is behaviour-preserving for any legitimate (nonzero) target and closes the pre-ENH-024 hole where passing 0 would erroneously match an unregistered slot. Leaf; only caller-save regs used. Mirrors find_flag_by_id's O(MAX_FLAGS) shape and MAX_FLAGS sentinel exactly, differing only in scan direction — the two functions are deliberately symmetric so a reader who understands one understands the other.",
      block: {
        lea r11, [rip + flag_count];
        mov rcx, [r11];                          // rcx = flag_count
        lea r8, [rip + flag_ids];                // r8  = &flag_ids[0]

      flfbi_loop:
        cmp rcx, 0;
        je flfbi_not_found;

        sub rcx, 1;                              // rcx = k (highest unvisited index)
        mov rdx, [r8 + rcx*8];                    // rdx = flag_ids[k]
        cmp rdx, 0;                              // ENH-024: skip unregistered
        je flfbi_loop;
        cmp rdx, rdi;
        je flfbi_found;

        jmp flfbi_loop;

      flfbi_found:
        mov rax, rcx;
        ret;

      flfbi_not_found:
        mov rax, 32;                              // MAX_FLAGS
        ret;
      }
    }

  // count_flag_by_id(id) -> u64   [libpdx-argv.ENH-008 + ENH-024]
  //   rdi (in)  = target id (0 = "no id / unregistered" — this scan
  //               SKIPS id==0 slots, so passing 0 ALWAYS returns 0
  //               regardless of how many unregistered flags are
  //               stored; see ENH-024 on find_flag_by_id above for
  //               the full rationale)
  //   rax (out) = number of stored flags whose flag_ids[k] == id
  //               AND flag_ids[k] != 0 (0 if never seen)
  //
  // For the repeat-count idiom (`-v -v -v` raising verbosity by 3
  // steps) where a consumer needs "how many times", not "which slot".
  //
  // Leaf. Register plan (all caller-save):
  //   rax = running count / return value
  //   rcx = loop index i
  //   r8  = flag_ids table base (hoisted once)
  //   r9  = flag_count upper bound (hoisted once)
  //   rdx = per-iteration flag_ids[i]
  //   r11 = scratch (only used briefly to load flag_count)
  pub let count_flag_by_id : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-008 + ENH-024 count_flag_by_id — full linear scan over flag_ids tallying every match. ENH-024 skips id==0 slots (permissive-mode unregistered flags) so that passing 0 as the target returns 0, not the number of unregistered flags in the record; behaviour-preserving for any legitimate (nonzero) target because id 0 is reserved as the 'unregistered' sentinel in the FlagSpec id-space. Leaf; only caller-save regs used. Unlike find_flag_by_id/find_last_flag_by_id this never early-exits (every slot must be inspected to count them all), so it is always O(flag_count) rather than best-case O(1).",
      block: {
        xor rax, rax;                            // rax = count = 0
        xor rcx, rcx;                            // rcx = i = 0
        lea r11, [rip + flag_count];
        mov r9, [r11];                            // r9 = flag_count
        lea r8, [rip + flag_ids];                 // r8 = &flag_ids[0]

      cfbi_loop:
        cmp rcx, r9;
        jge cfbi_done;

        mov rdx, [r8 + rcx*8];                    // rdx = flag_ids[i]
        cmp rdx, 0;                               // ENH-024: skip unregistered
        je cfbi_advance;
        cmp rdx, rdi;
        jne cfbi_advance;
        add rax, 1;

      cfbi_advance:
        add rcx, 1;
        jmp cfbi_loop;

      cfbi_done:
        ret;
      }
    }

  // ============================================================
  // error_count() -> u64    [libpdx-argv.ENH-017 (Closes #27)]
  //
  // Returns the number of error records the current parse has
  // accumulated into `error_ring_codes` / `error_ring_indices`
  // (0..MAX_COLLECTED_ERRORS, capped at the ring capacity). A parse
  // in non-collect mode that failed at the first ERR_* reports 1;
  // a parse in collect-all mode that observed N ≤ MAX_COLLECTED_ERRORS
  // recoverable failures reports N; a parse that overflowed the ring
  // reports MAX_COLLECTED_ERRORS (subsequent errors are silently
  // dropped from the ring but still trigger their normal advance-
  // past-argv-slot recovery). A successful parse reports 0.
  //
  // Consumer usage:
  //   let n = ParsedArgs::error_count()
  //   for i in 0..n {
  //     let (err_code, argv_index) = ParsedArgs::error_at(i)
  //     ...render one diagnostic line per (err_code, argv[argv_index])...
  //   }
  //
  // Leaf. Register plan (all caller-save):
  //   rax = return value (error_ring_count)
  //   r11 = lea scratch (cross-module .bss)
  //
  // paideia-as compliance: no test mnemonic, no imm > 0x7FFFFFFF,
  // r11 for lea, single-load-and-return shape.
  // ============================================================
  pub let error_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-017 (Closes #27) ParsedArgs::error_count — returns the current error_ring_count. Leaf; r11 lea scratch; single load into rax. Value is bounded above by MAX_COLLECTED_ERRORS (16) which fits imm32 trivially — no encoder concerns. The ring itself is populated by Parser::parse_argv_ex on every recoverable fail; error_count() is the pure read side of the ring API and never mutates state.",
      block: {
        lea r11, [rip + error_ring_count];
        mov rax, [r11];
        ret;
      }
    }

  // ============================================================
  // error_at(idx) -> (err_code in rax, argv_index in rdx)
  //                              [libpdx-argv.ENH-017 (Closes #27)]
  //
  // Returns the (err_code, argv_index) pair stored at ring slot
  // `idx`, using the SysV `rax:rdx` multi-return convention (same
  // shape FlagSpec::lookup and FlagSpec::get_range_by_id use).
  //
  //   rdi (in)  = ring index (0..MAX_COLLECTED_ERRORS - 1)
  //   rax (out) = error_ring_codes[idx]   (u64; a ParsedArgs::ERR_* code)
  //   rdx (out) = error_ring_indices[idx] (u64; the offending argv slot;
  //               semantics match `error_arg_index` for the corresponding
  //               fail path — argv index on the argv path, flag/pos loop
  //               index on the SchemaInvoke path)
  //
  // Out-of-range access (`idx >= error_ring_count` OR `idx >=
  // MAX_COLLECTED_ERRORS`) returns `(0, 0)` — the `0` err_code is
  // distinguishable from any real ERR_* because ERR_OK (0) is never
  // recorded in the ring (the ring is only appended to on failure).
  // Callers already gate their iteration on `error_count()`; the OOB
  // return path is a defensive no-op, not a contract callers rely on.
  //
  // Callers must treat rdx as clobbered across this call (as with
  // every multi-return function in this library).
  //
  // Leaf. Register plan (all caller-save):
  //   rdi = idx (input)
  //   rax = err_code / return
  //   rdx = argv_index / return
  //   rcx = bound check scratch (error_ring_count, then compared)
  //   r11 = lea scratch (cross-module .bss)
  //
  // paideia-as compliance: no test mnemonic, no imm > 0x7FFFFFFF
  // (MAX_COLLECTED_ERRORS = 16 fits imm8), r11 for lea, indexed
  // load via `[reg + rdi*8]` — no scaled `[reg + N*8]` with
  // immediate stride, addressing mode uses register-scaled index
  // which is inside the R49 encoder subset.
  // ============================================================
  pub let error_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-017 (Closes #27) ParsedArgs::error_at — multi-return (rax=err_code, rdx=argv_index) via the SysV rax:rdx pair, same convention lookup() and get_range_by_id() already use. Bounds gate rejects idx >= error_ring_count AND idx >= MAX_COLLECTED_ERRORS (belt-and-braces: the former is the API contract, the latter guards against a caller that ignored error_count() and passed a fixed loop bound that outgrew the ring's physical size), returning (0, 0) in both cases — 0 is not a valid ERR_* code so the OOB sentinel is unambiguous. Leaf; only caller-save regs used. r11 for lea; indexed load via `[r11 + rdi*8]` stays inside the R49 encoder subset. MAX_COLLECTED_ERRORS immediate (16) fits imm8 trivially.",
      block: {
        // Bound: idx < error_ring_count?
        lea r11, [rip + error_ring_count];
        mov rcx, [r11];
        cmp rdi, rcx;
        jae error_at_oob;
        // Bound: idx < MAX_COLLECTED_ERRORS? Defensive against a
        // caller that ignored error_count and passed a stale index.
        cmp rdi, 16;                          // MAX_COLLECTED_ERRORS
        jae error_at_oob;

        // In-range: load both parallel slots.
        lea r11, [rip + error_ring_codes];
        mov rax, [r11 + rdi*8];
        lea r11, [rip + error_ring_indices];
        mov rdx, [r11 + rdi*8];
        ret;

      error_at_oob:
        xor rax, rax;                         // OOB → (0, 0)
        xor rdx, rdx;
        ret;
      }
    }
}
