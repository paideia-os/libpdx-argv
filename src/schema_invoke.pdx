// src/schema_invoke.pdx — libpdx-argv.M3-001
// SchemaInvoke: alternate invocation path for libpdx-argv.
//
// A tool can be called two ways:
//   (1) argv (text CLI)     — Parser::parse_argv
//   (2) semantic-pipe frame — SchemaInvoke::parse_from_schema_record
//
// Both paths converge on the same ParsedArgs singleton so the tool's
// implementation never asks which path fed it. When the parent tool
// (e.g. another R49/R50 tool spawning a coreutil via libpdx-semantic-
// pipe) already knows the callee's `--schema` shape, path (2) skips
// the text-tokenize step and hands the callee a typed record whose
// flag_names/values are offsets into the frame buffer.
//
// Wire form (v1) — the entire record body sits in caller-owned memory
// that libpdx-argv borrows (same convention as argv). Pointers written
// into ParsedArgs are computed as record_ptr + offset; they stay valid
// while the caller keeps the record buffer live.
//
//   offset  size  meaning
//   ------  ----  --------------------------------------------------
//   0       8     magic  = "PDXARGV\0" ASCII (8 bytes LE)
//   8       8     version (u64 LE, must equal 1 at M3)
//   16      8     flag_count (u64, 0..MAX_FLAGS=32)
//   24      8     pos_count  (u64, 0..MAX_POS=32)
//   32      —     flag_count × { u64 name_off, u64 value_off }
//                 (16 bytes per flag; value_off == 0 → boolean)
//   next    —     pos_count × u64 pos_off
//   rest    —     string table: NUL-terminated strings the offsets
//                 above point at.
//
// Offset + terminator validation (libpdx-argv.ENH-001). Every
// name_off / value_off / pos_off is now range-gated before it is
// dereferenced: a nonzero offset must satisfy `off < record_len`
// (unsigned compare — this is an untrusted wire field, see ENH-002)
// or the call fails with ERR_SCHEMA_BAD_OFFSET (10) and
// error_arg_index = the flag/pos loop index. value_off == 0 keeps its
// boolean-sentinel meaning and is never range-checked. Once an offset
// passes the range gate, the resulting pointer is scanned for a NUL
// byte before `record_ptr + record_len`; a string that runs to the
// end of the frame with no terminator fails with
// ERR_SCHEMA_UNTERMINATED (11), same error_arg_index convention.
// FlagSpec::lookup is never called on a name pointer that failed
// either check — see ParseSchemaRecord case9/case10 for the fixtures.
//
// The parser consults FlagSpec::lookup(name) for every stored flag so
// flag_ids[k] and flag_kinds[k] are populated identically to the argv
// path. Consumers dispatching by `ParsedArgs::find_flag_by_id` work
// unchanged.
//
// Preconditions
// -------------
//   - ParsedArgs::reset() has been called (mirrors parse_argv).
//   - FlagSpec has been populated (typically StdVocab::register_all()
//     plus any tool-specific FlagSpec::register calls).
//
// Postconditions
// --------------
//   - On success (rax = ERR_OK): ParsedArgs::{flag_names, flag_values,
//     flag_ids, flag_kinds, flag_count, pos_ptrs, pos_count} populated;
//     ddash_seen / emit_schema untouched (they don't apply to the
//     record path — the sender either sets emit_schema semantically
//     via a registered flag id or doesn't).
//   - On failure (rax != ERR_OK): error_code and error_arg_index set
//     (error_arg_index carries the flag/pos index at which failure
//     occurred; 0 for header failures).
//
// See design/architecture.md §10.1 for the wire-form rationale.
// Upstream: design/tooling/r49-r50-plan.md §5.12 M3-001 (paideia-os).
//
// Cross-module symbols read/written:
//   ParsedArgs: flag_names, flag_values, flag_count, pos_ptrs,
//               pos_count, error_code, error_arg_index, flag_ids,
//               flag_kinds
//   FlagSpec::  lookup (called qualified)
//
// paideia-as compliance
// ---------------------
//   - Module SchemaInvoke (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (max: 32 for MAX_FLAGS/MAX_POS,
//     single-byte ASCII for magic-byte checks). Record-length compares
//     use cmp reg, reg after loading counts.
//   - r11 is scratch (used only for cross-module .bss lea).
//   - Byte loads use xor rax, rax; mov_b rax, [ptr] per #1248.
//   - SysV push/pop parity: 6 pushes (rbx, rbp, r12, r13, r14, r15)
//     + sub rsp, 8 = 7*8 slots on stack after ret addr → rsp%16 = 0
//     at every nested call site (mirrors Parser::parse_argv).

module SchemaInvoke = structure {

  // ============================================================
  // Wire-form constants — do NOT tune without a coordinated bump in
  // libpdx-semantic-pipe.M2's schema fingerprint for PdxArgvRecord@0.1.
  // ============================================================
  pub let SCHEMA_HEADER_SIZE  : u64 = 32     // magic + version + 2 counts
  pub let SCHEMA_FLAG_STRIDE  : u64 = 16     // u64 name_off + u64 value_off
  pub let SCHEMA_POS_STRIDE   : u64 = 8      // u64 pos_off
  pub let SCHEMA_VERSION_V1   : u64 = 1

  // ============================================================
  // parse_from_schema_record(record_ptr, record_len) -> u64
  //   rdi = record_ptr (caller-owned; borrowed for the ParsedArgs
  //         lifetime — the flag_names/values/pos_ptrs stored are
  //         record_ptr + offset, i.e. interior pointers)
  //   rsi = record_len (bytes of caller-owned record buffer)
  //   rax = ERR_OK (0) on success, else one of the ERR_* codes.
  //
  // Non-leaf (calls FlagSpec::lookup once per flag stored, and
  // scan_terminated once per validated offset).
  //
  // Register plan (mirrors Parser::parse_argv):
  //   rbx = record_ptr (base for offset dereferences) — never reused
  //   r12 = record_len (bounds ceiling) — never reused; end_ptr for a
  //         bounds check is recomputed on demand as rbx + r12 rather
  //         than cached, so no seventh callee-saved slot is needed
  //   r9  = flag_count, loaded once from the header and read every
  //         flag-loop iteration — never reused as scratch
  //   r10 = pos_count, loaded once from the header and read at the
  //         pos-loop head — never reused as scratch (libpdx-argv.ENH-001
  //         fix: the pre-ENH-001 code clobbered r10 inside the flag
  //         loop via `mov r10, r13; shl r10, 4` for the entry_base
  //         calc, corrupting pos_count for every record with
  //         flag_count > 0; the entry_base calc now uses r8, which is
  //         free at that point in the iteration)
  //   r13 = loop index i (flag loop) / j (pos loop)
  //   rbp = flag loop: name pointer, preserved across FlagSpec::lookup
  //         and scan_terminated. pos loop: pos_ptr, preserved across
  //         scan_terminated (r15 and rbp are both free once the flag
  //         loop is done, so pos_ptr reuses rbp for the same
  //         "must-survive-a-call" role rather than a caller-saved reg)
  //   r14 = flag loop: value pointer preserved across both calls (0 =
  //         boolean, never validated/scanned). pos loop: positional-
  //         array base, preserved across scan_terminated
  //   r15 = flag loop only: id returned by lookup, preserved for the
  //         store sequence
  //
  //   rax = byte/qword load / lookup or scan_terminated return / rc
  //   rcx = slot cursor / walk cursor / value_off holding reg
  //   rdx = per-iteration flag entry base / scratch
  //   r8  = per-iteration name_off / value_off / pos_off / entry_base
  //         scratch (i*16) — never needs to survive a call
  //   r11 = lea scratch for cross-module .bss bases
  // ============================================================
  pub let parse_from_schema_record : (u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (record_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.M3-001 + ENH-001 + ENH-004 SchemaInvoke::parse_from_schema_record — alternate invocation path that reads a v1 typed record (magic + version + counts + flag/positional offsets + string table) and populates the same ParsedArgs singleton the argv path fills. Non-leaf: calls FlagSpec::lookup(name) per stored flag and scan_terminated per validated offset, so flag_ids/flag_kinds are populated identically to Parser::parse_argv only for offsets that passed range + terminator validation. Prologue mirrors Parser::parse_argv exactly (push rbx/rbp/r12/r13/r14/r15 + sub rsp, 8 = 7 slots → rsp%16 = 0 at every call site). Magic check is 8 byte-compares (M1 --pdx-schema-compare pattern; avoids imm64). Bounds check clamps flag_count/pos_count against MAX_FLAGS/MAX_POS (=32, well ≤ 0x7FFFFFFF) and against a computed minimum-record-size (also reg-reg compare after loading counts). ENH-001: every name_off/value_off(if nonzero)/pos_off is range-gated (off != 0 && off < record_len, unsigned) before it is dereferenced, and the resulting pointer is scanned for a NUL before record_ptr+record_len; either failure returns before FlagSpec::lookup is ever called on the pointer. ENH-001 also fixes a register-clobber bug: the pre-ENH-001 entry_base calc reused r10 (which holds pos_count for the whole function) as scratch for i*16, corrupting the pos-loop bound whenever flag_count > 0 — it now uses r8, which is dead at that point in the iteration. ENH-004: immediately after FlagSpec::lookup returns, if kind is FKIND_UNKNOWN and FlagSpec::strict_mode is nonzero, fails with ERR_UNKNOWN_FLAG (12) before any store, using rcx (not r10, for the same pos_count-preservation reason ENH-001 fixed) to hold the strict_mode value. Every store into ParsedArgs mirrors the M2 parser's flag store (name/value/id/kind quartet at [rcx*8]). error_arg_index carries the loop index at failure (0 for header failures).",
      block: {
        // ---- prologue (6 pushes + 8-byte pad → rsp%16 = 0) --------------
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                       // rbx = record_ptr
        mov r12, rsi;                       // r12 = record_len

        // ---- Header size gate (need at least 32 bytes for header) -------
        // record_len is a u64 read straight off the wire — compare
        // unsigned (jb) so a value with bit 63 set (e.g. 0x8000...0001)
        // is treated as the huge unsigned quantity it is, not as a
        // negative number that would be falsely rejected here.
        cmp r12, 32;                        // SCHEMA_HEADER_SIZE
        jb schema_bad_layout_header;

        // ---- Magic check: bytes[0..8] == "PDXARGV\0" (0x50 44 58 41 52 47 56 00) ---
        xor rax, rax; mov_b rax, [rbx + 0]; cmp rax, 0x50; jne schema_bad_magic;  // 'P'
        xor rax, rax; mov_b rax, [rbx + 1]; cmp rax, 0x44; jne schema_bad_magic;  // 'D'
        xor rax, rax; mov_b rax, [rbx + 2]; cmp rax, 0x58; jne schema_bad_magic;  // 'X'
        xor rax, rax; mov_b rax, [rbx + 3]; cmp rax, 0x41; jne schema_bad_magic;  // 'A'
        xor rax, rax; mov_b rax, [rbx + 4]; cmp rax, 0x52; jne schema_bad_magic;  // 'R'
        xor rax, rax; mov_b rax, [rbx + 5]; cmp rax, 0x47; jne schema_bad_magic;  // 'G'
        xor rax, rax; mov_b rax, [rbx + 6]; cmp rax, 0x56; jne schema_bad_magic;  // 'V'
        xor rax, rax; mov_b rax, [rbx + 7]; cmp rax, 0;    jne schema_bad_magic;  // NUL

        // ---- Version check (must equal 1) -------------------------------
        mov rax, [rbx + 8];
        cmp rax, 1;                         // SCHEMA_VERSION_V1
        jne schema_unsupported_version;

        // ---- flag_count and pos_count (both must be ≤ 32 = MAX_FLAGS/MAX_POS)
        // Both are u64 wire fields — compare unsigned (ja) so a
        // negative-looking value (bit 63 set, e.g. 0xFFFF...FFFF or
        // 0x8000...0000) is correctly treated as far greater than 32
        // rather than passing a signed jg cap.
        mov r9, [rbx + 16];                 // r9 = flag_count
        cmp r9, 32;
        ja schema_bad_layout_header;
        mov r10, [rbx + 24];                // r10 = pos_count
        cmp r10, 32;
        ja schema_bad_layout_header;

        // ---- Body-fits gate: record_len must be at least
        //      SCHEMA_HEADER_SIZE + flag_count*SCHEMA_FLAG_STRIDE
        //                        + pos_count *SCHEMA_POS_STRIDE
        //      (string table adds more; opaque here — we validate the
        //       arrays we're about to index, nothing beyond).
        //   rcx = flag_count * 16 = flag_count << 4
        //   rdx = pos_count  *  8 = pos_count  << 3
        //   r8  = 32 + rcx + rdx  (min tail-inclusive record size)
        mov rcx, r9;
        shl rcx, 4;                         // rcx = flag_count * 16
        mov rdx, r10;
        shl rdx, 3;                         // rdx = pos_count  * 8
        mov r8, 32;                         // r8 = SCHEMA_HEADER_SIZE
        add r8, rcx;
        add r8, rdx;
        // record_len (r12) vs. computed minimum tail-inclusive size
        // (r8) — both are u64 wire-derived quantities; compare
        // unsigned (jb) for the same reason as the two gates above.
        cmp r12, r8;
        jb schema_bad_layout_header;

        // ---- Flag loop ---------------------------------------------------
        // For each i in 0..flag_count:
        //   entry_base = record_ptr + 32 + i*16
        //   name_off   = [entry_base + 0]
        //   value_off  = [entry_base + 8]
        //   validate name_off  (!= 0 && < record_len) or ERR_SCHEMA_BAD_OFFSET
        //   name_ptr   = record_ptr + name_off
        //   scan name_ptr..record_ptr+record_len for a NUL, else
        //     ERR_SCHEMA_UNTERMINATED
        //   value_ptr  = value_off == 0 ? 0 : record_ptr + value_off
        //     (value_off == 0 keeps its boolean-sentinel meaning and is
        //     never range-checked or scanned; nonzero value_off gets
        //     the same two gates as name_off)
        //   lookup(name_ptr) → (kind, id)   — only reached once both
        //     offsets that were present have cleared validation
        //   store (name_ptr, value_ptr, id, kind) at flag_names[i], etc.
        //
        // r14 = value_ptr (preserved across scan_terminated + lookup)
        // rbp = name_ptr  (preserved across scan_terminated + lookup)
        // r15 = id        (preserved from lookup return through store)
        // rax = kind      (preserved from lookup return through store —
        //                  the arms below deliberately avoid rax)
        //
        // Loop index i lives in r13.
        xor r13, r13;                       // r13 = i = 0

      schema_flag_loop_head:
        cmp r13, r9;                        // r9 still holds flag_count
        jge schema_flag_loop_done;

        // entry_base = record_ptr + 32 + i*16
        //   r8  = i * 16 (scratch — reloaded with name_off below; never
        //         needs to survive past this point, unlike the
        //         pre-ENH-001 code which used r10 here and corrupted
        //         pos_count for any record with flag_count > 0)
        //   rdx = record_ptr + 32 + r8
        mov r8, r13;
        shl r8, 4;
        mov rdx, rbx;
        add rdx, 32;
        add rdx, r8;

        // name_off  = [entry_base + 0]
        // value_off = [entry_base + 8]
        mov r8, [rdx + 0];                  // r8 = name_off
        mov rcx, [rdx + 8];                 // rcx = value_off

        // ---- Validate name_off: off != 0 && off < record_len ----------
        cmp r8, 0;
        je schema_bad_offset;
        cmp r8, r12;                        // unsigned: record_len is a
        jae schema_bad_offset;              // wire field (ENH-002 rationale)

        // name_ptr = record_ptr + name_off (rbp)
        mov rbp, rbx;
        add rbp, r8;

        // ---- Bounded NUL scan on name_ptr ------------------------------
        mov rdi, rbp;
        mov rsi, rbx;
        add rsi, r12;                       // rsi = record_ptr + record_len
        call scan_terminated;
        cmp rax, 0;
        je schema_unterminated;

        // value_ptr = (value_off == 0) ? 0 : record_ptr + value_off  (r14)
        xor r14, r14;
        cmp rcx, 0;
        je schema_flag_lookup;

        // ---- Validate value_off: off < record_len (nonzero already true) --
        cmp rcx, r12;
        jae schema_bad_offset;

        mov r14, rbx;
        add r14, rcx;

        // ---- Bounded NUL scan on value_ptr ------------------------------
        mov rdi, r14;
        mov rsi, rbx;
        add rsi, r12;
        call scan_terminated;
        cmp rax, 0;
        je schema_unterminated;

      schema_flag_lookup:
        // Call FlagSpec::lookup(name_ptr).
        mov rdi, rbp;
        call lookup;              // rax=kind, rdx=id
        mov r15, rdx;                       // r15 = id (preserved)
        // rax = kind (preserved for the store below — no arm here
        // clobbers rax before the flag_kinds write).

        // -- libpdx-argv.ENH-004 strict mode: reject unregistered flags --
        // Uses rcx (not r10 — r10 holds pos_count for the whole
        // function, see the ENH-001 register-clobber note above; rcx
        // is dead here and gets a fresh load in the flag_count bounds
        // check right below regardless).
        cmp rax, 0xFF;                      // FKIND_UNKNOWN
        jne schema_flag_not_unknown;
        lea r11, [rip + strict_mode];
        mov rcx, [r11];
        cmp rcx, 0;
        je schema_flag_not_unknown;
        jmp schema_unknown_flag;
      schema_flag_not_unknown:

        // Bounds check the flag_count slot (paranoia — flag_count was
        // already gated ≤ MAX_FLAGS at the header, but ParsedArgs's
        // reset() left flag_count at 0 and every store increments it,
        // so we re-check against MAX_FLAGS to keep the storage discipline
        // uniform with Parser::parse_argv).
        lea r11, [rip + flag_count];
        mov rcx, [r11];
        cmp rcx, 32;                        // MAX_FLAGS
        jge schema_flag_overflow;

        lea r11, [rip + flag_names];
        mov [r11 + rcx*8], rbp;
        lea r11, [rip + flag_values];
        mov [r11 + rcx*8], r14;
        lea r11, [rip + flag_ids];
        mov [r11 + rcx*8], r15;
        lea r11, [rip + flag_kinds];
        mov [r11 + rcx*8], rax;

        add rcx, 1;
        lea r11, [rip + flag_count];
        mov [r11], rcx;

        add r13, 1;
        jmp schema_flag_loop_head;

      schema_flag_loop_done:
        // ---- Positional loop --------------------------------------------
        // For each i in 0..pos_count:
        //   entry_base = record_ptr + 32 + flag_count*16 + i*8
        //   pos_off    = [entry_base]
        //   pos_ptr    = record_ptr + pos_off
        //   store pos_ptr at pos_ptrs[i]
        //
        // r10 already = pos_count. r9 = flag_count (still).
        // Recompute the positional-array base: r14 = record_ptr + 32 +
        // flag_count*16 (r14 is a fresh register here — the flag-loop
        // spill is done).
        mov r14, r9;
        shl r14, 4;                         // r14 = flag_count * 16
        add r14, 32;
        add r14, rbx;                       // r14 = &positional_array[0]

        xor r13, r13;                       // r13 = j = 0

      schema_pos_loop_head:
        cmp r13, r10;                       // r10 = pos_count (ENH-001:
        jge schema_ok;                      // no longer clobbered by the flag loop)

        // pos_off = [r14 + j*8]
        mov r8, [r14 + r13*8];              // r8 = pos_off

        // ---- Validate pos_off: off != 0 && off < record_len ------------
        cmp r8, 0;
        je schema_bad_offset;
        cmp r8, r12;                        // unsigned (ENH-002 rationale)
        jae schema_bad_offset;

        // pos_ptr = record_ptr + pos_off. Held in rbp (free here — the
        // flag loop's name_ptr use of rbp is done) so it survives the
        // scan_terminated call without a caller-saved spill.
        mov rbp, rbx;
        add rbp, r8;

        // ---- Bounded NUL scan on pos_ptr --------------------------------
        mov rdi, rbp;
        mov rsi, rbx;
        add rsi, r12;                       // rsi = record_ptr + record_len
        call scan_terminated;
        cmp rax, 0;
        je schema_unterminated;

        lea r11, [rip + pos_count];
        mov rcx, [r11];
        cmp rcx, 32;                        // MAX_POS
        jge schema_pos_overflow;

        lea r11, [rip + pos_ptrs];
        mov [r11 + rcx*8], rbp;

        add rcx, 1;
        lea r11, [rip + pos_count];
        mov [r11], rcx;

        add r13, 1;
        jmp schema_pos_loop_head;

      schema_ok:
        xor rax, rax;                       // ERR_OK
        lea r11, [rip + error_code];
        mov [r11], rax;
        jmp schema_epilogue;

      schema_bad_magic:
        mov rax, 7;                         // ERR_SCHEMA_BAD_MAGIC
        xor r13, r13;                       // arg_index = 0 (header)
        jmp schema_fail;

      schema_unsupported_version:
        mov rax, 8;                         // ERR_SCHEMA_UNSUPPORTED_VERSION
        xor r13, r13;
        jmp schema_fail;

      schema_bad_layout_header:
        mov rax, 9;                         // ERR_SCHEMA_BAD_LAYOUT
        xor r13, r13;
        jmp schema_fail;

      schema_flag_overflow:
        mov rax, 1;                         // ERR_FLAG_OVERFLOW
        jmp schema_fail;

      schema_pos_overflow:
        mov rax, 2;                         // ERR_POS_OVERFLOW
        jmp schema_fail;

      schema_bad_offset:
        mov rax, 10;                        // ERR_SCHEMA_BAD_OFFSET
        jmp schema_fail;                    // r13 = current loop index (i or j)

      schema_unterminated:
        mov rax, 11;                        // ERR_SCHEMA_UNTERMINATED
        jmp schema_fail;                    // r13 = current loop index (i or j)

      schema_unknown_flag:
        mov rax, 12;                        // ERR_UNKNOWN_FLAG (ENH-004)
        jmp schema_fail;                    // r13 = current flag loop index i

      schema_fail:
        // rax = error code. r13 = loop index (or 0 for header failures).
        lea r11, [rip + error_code];
        mov [r11], rax;
        lea r11, [rip + error_arg_index];
        mov [r11], r13;
        // fall through to epilogue

      schema_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ============================================================
  // scan_terminated(ptr, end_ptr) -> u64          (libpdx-argv.ENH-001)
  //
  // Internal helper: scans forward from `ptr` (inclusive) up to
  // `end_ptr` (exclusive) looking for a NUL byte. Used by
  // parse_from_schema_record to bound-check every string offset it
  // has already range-validated (name/value/pos) before treating the
  // pointer as NUL-terminated (e.g. before handing it to
  // FlagSpec::lookup, which walks it byte-by-byte with no bound of
  // its own).
  //
  //   rdi (in)  = ptr      (start of the candidate string; already
  //               known to satisfy ptr < end_ptr — the caller range-
  //               checked the offset before computing this pointer)
  //   rsi (in)  = end_ptr  (record_ptr + record_len; exclusive bound)
  //   rax (out) = 1 if a NUL byte was found before end_ptr, else 0
  //
  // Leaf. No nested calls, no callee-saved registers touched — safe
  // to call with any live value in rbx/rbp/r12..r15.
  //
  // Register plan (all caller-save; leaf):
  //   rdi = cursor (mutated in place; caller does not rely on rdi
  //         surviving the call, same convention as every other call
  //         site in this file)
  //   rsi = end_ptr (read-only)
  //   rax = current byte / return value
  // ============================================================
  pub let scan_terminated : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (end_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-argv.ENH-001 SchemaInvoke::scan_terminated — bounded NUL scan used to validate every string offset (name/value/pos) that parse_from_schema_record range-checks before dereferencing. Leaf; only rdi/rsi/rax touched, so it is safe to call with the flag/pos loop's live callee-saved state (rbx=record_ptr, rbp=candidate ptr saved by the caller if needed post-call, r9/r10/r12/r13/r14/r15) untouched. Loop compares the cursor against end_ptr with cmp+jae (pointer compare, not a wire-integer sign concern) and every byte zero-check uses cmp rax, 0 per the no-test-mnemonic convention. Byte load is xor rax,rax; mov_b rax,[rdi] per #1248.",
      block: {
      scan_terminated_loop:
        cmp rdi, rsi;
        jae scan_terminated_not_found;

        xor rax, rax; mov_b rax, [rdi];
        cmp rax, 0;
        je scan_terminated_found;

        add rdi, 1;
        jmp scan_terminated_loop;

      scan_terminated_found:
        mov rax, 1;
        ret;

      scan_terminated_not_found:
        xor rax, rax;
        ret;
      }
    }
}
