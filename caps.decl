# libpdx-argv — caps.decl
#
# Wave: R49
# Doc:  design/tooling/r49-r50-plan.md §3.3 in the paideia-os repo.
#
# libpdx-argv is a pure userspace library. It reads only the caller's own
# argv memory and (for --foo=bar) mutates that memory in place to null-
# terminate on the '='. It requires NO capabilities of its own. The
# caller's argv memory is already backed by cap grants the caller holds
# (typically the loader's InitCap sidecar per
# src/kernel/core/loader/init_caps.pdx in paideia-os).
#
# libpdx-argv.ENH-032 (Closes #25, 2026-09-10): the pre-1.2 language
# "performs NO syscalls of its own" is narrowed. VersionBackend::
# emit_default issues seven raw sys_write syscalls on fd 1 (seven,
# so the byte sequence is written as separate segments rather than
# buffered into a single write — the library holds no scratch large
# enough to buffer arbitrary tool-side PDX_TOOL_VERSION strings, and
# a short-write on any segment leaves fd 1 in a self-consistent state
# rather than a truncated mid-buffer state). The emit path fires only
# when the parser observes the argv slot equal to `--version` AND
# the tool has not opted out via VersionBackend::set_override(1);
# every other libpdx-argv entry point remains syscall-free.
#
# Cap posture unchanged: the syscall inherits the caller's fd-1 cap
# at the process boundary, not any cap this library holds. A
# consumer that lacks a KIND_TTY / KIND_IPC_ENDPOINT cap on fd 1
# (there is no such consumer among the R49+R50 P0 tools; every P0
# holds it) sees the syscalls fail with EBADF and emit_default
# returns anyway — the auto-emit is best-effort and the tool exits
# after parse_argv returns ERR_VERSION_EMITTED (13) either way.
# This is the same silent-write policy the schema-emit consumer
# pattern uses.
#
# libpdx-argv.ENH-014 (Closes #24, 2026-09-10): the carve-out above
# extends to a second library-owned emitter — HelpBackend::
# emit_from_argspec. It issues five raw sys_write syscalls on fd 1
# per registered flag whose spec_help[i] slot is non-null (literal
# `--`, name, TAB, help, LF); rows whose help slot is null are
# silently suppressed and cost zero syscalls. Fires only when the
# parser observes --help (or a single-letter short flag with id ==
# StdVocab::STD_ID_HELP) AND the tool has opted into the fallback
# via HelpBackend::set_doc_unavailable(1). Same cap posture and
# silent-write policy as emit_default: a consumer without a
# KIND_TTY / KIND_IPC_ENDPOINT cap on fd 1 sees the syscalls fail
# with EBADF and the emitter returns anyway; the tool exits after
# parse_argv returns ERR_HELP_EMITTED (15) either way.
#
# Callers that use libpdx-argv must independently declare in their own
# caps.decl any caps their tool needs (KIND_USER, KIND_TTY, KIND_PDXFS_*,
# KIND_IPC_ENDPOINT, ...). This file exists so the R49 caps-manifest
# tooling can consult a uniform declaration for every library.
requires: (none)

# libpdx-argv.ENH-003 (2026-08-25): PdxArgvParsed@0.1 was declared here
# at 1.0 but never had a producer anywhere in src/ — --pdx-schema only
# ever set the emit_schema bit, and no function serializes ParsedArgs
# into that wire shape. Withdrawn rather than implemented; no known
# consumer depended on it (see CHANGELOG.md's dated correction on the
# 1.0 entry).
#
# PdxArgvRecord@0.1 was also misfiled under declares_output_schemas:
# at 1.0 — it is this library's only *input* wire schema
# (SchemaInvoke::parse_from_schema_record decodes it; nothing here
# encodes/emits it — see design/architecture.md §10.1 for the wire
# form). The caps.decl grammar this file's own sibling libpdx-cap
# parses (src/caps_decl.pdx there) recognises only `requires:` and
# `declares_output_schemas:` as top-level keys — there is no
# `consumes_input_schemas:` (or equivalent) key in that grammar to
# declare it correctly, so it is recorded here as prose only rather
# than invented as new parseable syntax that libpdx-cap's own parser
# would reject as CAPS_DECL_MALFORMED_HEADER. declares_output_schemas:
# is therefore correctly empty below — this library declares no
# output schema of its own onto a semantic pipe.
#
# PdxArgvRecord@0.1 is this library's only untrusted-input surface (a
# peer process hands it a frame across a KIND_IPC_ENDPOINT). Every
# name_off/value_off/pos_off is range-validated against the record
# length and every resulting string is scanned for a NUL terminator
# before the record's end before SchemaInvoke::parse_from_schema_record
# dereferences it — see ERR_SCHEMA_BAD_OFFSET / ERR_SCHEMA_UNTERMINATED
# in src/parsed_args.pdx (libpdx-argv.ENH-001).
declares_output_schemas: (none)
